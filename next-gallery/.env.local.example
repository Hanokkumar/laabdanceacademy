# Cloudinary — Dashboard → API Keys → copy "Environment variable" style URL
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Optional: folder inside Cloudinary Media Library (default: next-gallery)
# CLOUDINARY_UPLOAD_FOLDER=next-gallery

# Firebase Admin — Project settings → Service accounts → Generate new private key.
# Paste the entire JSON as one line (minified), or use a secret manager in production.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
